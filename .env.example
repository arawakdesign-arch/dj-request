# ══ SUPABASE ══════════════════════════════════════════════════════
# Trouvez ces valeurs dans : Supabase → Settings → API
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=votre_anon_key_publique
SUPABASE_SERVICE_KEY=votre_service_role_key_privee

# ══ APP ═══════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# Mot de passe organisateur (changez-le !)
ORGANIZER_PASSWORD=djrequest2026!

# URL publique de l'app (votre domaine)
APP_URL=https://www.votre-domaine.fr

